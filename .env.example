# Canonical variables — use these exact names in .env and Vercel.
TURSO_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
SESSION_SECRET=replace-with-a-long-random-secret
IMGBB_API_KEY=your-imgbb-api-key

# Transactional email (password recovery / email verification)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=Bashe Dairy Farm <no-reply@yourdomain.com>
APP_URL=http://localhost:5173

# Frontend (safe to expose; these are embedded in the client build)
VITE_APP_URL=http://localhost:5173
VITE_API_URL=/api

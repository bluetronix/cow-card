# Turso database (server-side only — never expose these to the client)
TURSO_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-secret

# ImgBB image hosting (server-side proxy)
IMGBB_API_KEY=your-imgbb-api-key

# Frontend
VITE_APP_URL=http://localhost:5173
# Optional: point the client at a deployed API. Defaults to /api.
VITE_API_URL=/api
